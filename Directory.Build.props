


<Project>
	
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<!--<LangVersion>preview</LangVersion>-->
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
		
		<Nullable>enable</Nullable>
		
		<!--<NoWarn>$(NoWarn);1701;1702;CA1416</NoWarn>-->
		
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)obj\Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>
	
	<Import Project="Local.Directory.Build.props" Condition="Exists('Local.Directory.Build.props')" />
	
</Project>


