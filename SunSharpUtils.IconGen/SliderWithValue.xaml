<UserControl x:Class="IconGen.SliderWithValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IconGen"
             mc:Ignorable="d" 
			 d:Background="White"
             d:DesignWidth="800">
	<DockPanel>
		<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,5,0" VerticalAlignment="Center">
			<TextBlock FontFamily="Cascadia Code" d:Text="Description" x:Name="tb_description" />
			<TextBlock FontFamily="Cascadia Code" Text=": " />
			<TextBlock FontFamily="Cascadia Code" d:Text="123.456" x:Name="tb_value" />
		</StackPanel>
		<Slider x:Name="s_value" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" d:Minimum="0" d:Maximum="100" d:Value="33" />
	</DockPanel>
</UserControl>
