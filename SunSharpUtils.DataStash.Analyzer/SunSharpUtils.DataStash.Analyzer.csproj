<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>true</IncludeBuildOutput>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\SunSharpUtils.Ext.UniversalBin\SunSharpUtils.Ext.UniversalBin.csproj" />
        <ProjectReference Include="..\SunSharpUtils.Threading\SunSharpUtils.Threading.csproj" />
        <ProjectReference Include="..\SunSharpUtils.WinSvc\SunSharpUtils.WinSvc.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <Compile Include="..\SunSharpUtils.DataStash\**\*.cs" />
        <Compile Remove="..\SunSharpUtils.DataStash\obj\**\*.cs" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(OutputPath)\SunSharpUtils.Ext.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
    
</Project>
