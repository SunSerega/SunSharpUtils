<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>
	
	<ItemGroup>
		<EmbeddedResource Include="ToCopy\*.cs" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\SunSharpUtils.Ext.UniversalBin\SunSharpUtils.Ext.UniversalBin.csproj" />
		<ProjectReference Include="..\SunSharpUtils.Ext\SunSharpUtils.Ext.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\SunSharpUtils.Threading\SunSharpUtils.Threading.csproj" />
		<ProjectReference Include="..\SunSharpUtils.WinSvc\SunSharpUtils.WinSvc.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>
	
	<!-- TODO Why does VS show bin folder as deleted when these are included? -->
	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="$(OutputPath)\SunSharpUtils.Ext.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>
	
</Project>
